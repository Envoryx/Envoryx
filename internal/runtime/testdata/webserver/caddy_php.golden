# Generated by Envoryx - do not edit, changes are overwritten.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /var/www/html/public
	encode gzip
	@dot {
		path_regexp (^|/)\.
		not path /.well-known/*
	}
	respond @dot 404
	@uploadphp path_regexp (?i)(?:/wp-content/uploads|/app/uploads|/sites/[^/]+/files|/fileadmin|/typo3temp|/cpresources|^/(?:uploads|media|thumbnail|storage|assets|images))/.*\.php(?:/|$)
	respond @uploadphp 403
	@uploadindex {
		path_regexp (?i)(?:/wp-content/uploads|/app/uploads|/sites/[^/]+/files|/fileadmin|/typo3temp|/cpresources|^/(?:uploads|media|thumbnail|storage|assets|images))/(?:.*/)?$
		file {path}index.php
	}
	respond @uploadindex 403
	@htmlindex {
		not path */
		file {path}/index.html
		not file {path}/index.php
	}
	redir @htmlindex {http.request.orig_uri.path}/ 308
	@https header X-Forwarded-Proto https
	map {http.request.port} {envoryx_https_port} {
		~^(\d+)$ ${1}
		default 443
	}
	php_fastcgi @https php:9000 {
		try_files {path} {path}/index.php {path}/index.html index.php
		env HTTPS on
		env REQUEST_SCHEME https
		env SERVER_PORT {envoryx_https_port}
	}
	php_fastcgi php:9000 {
		try_files {path} {path}/index.php {path}/index.html index.php
	}
	file_server
	log {
		output stdout
		format console
	}
}
