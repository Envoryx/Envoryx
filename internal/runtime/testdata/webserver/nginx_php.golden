# Generated by Envoryx - do not edit, changes are overwritten.
map $http_x_forwarded_proto $envoryx_https {
	https on;
	default $https;
}
map $http_x_forwarded_proto $envoryx_scheme {
	https https;
	default $scheme;
}
map "$http_x_forwarded_proto:$http_host" $envoryx_port {
	"~^https:.*:([0-9]+)$" $1;
	"~^https:" 443;
	default $server_port;
}

server {
	listen 80;
	server_name _;
	root /var/www/html/public;
	index index.php index.html;

	client_max_body_size 0;
	gzip on;
	gzip_types text/plain text/css text/xml application/json application/javascript application/xml image/svg+xml;

	access_log /dev/stdout;
	error_log /dev/stderr;

	location / {
		try_files $uri $uri/ /index.php?$query_string;
	}

	location ~ "(?i)(?:/wp-content/uploads|/app/uploads|/sites/[^/]+/files|/fileadmin|/typo3temp|^/(?:uploads|media|thumbnail|storage))/.*\.php(?:/|$)" {
		deny all;
	}

	location ~ \.php$ {
		try_files $uri =404;
		fastcgi_pass php:9000;
		fastcgi_index index.php;
		include fastcgi_params;
		fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
		fastcgi_param HTTPS $envoryx_https if_not_empty;
		fastcgi_param REQUEST_SCHEME $envoryx_scheme;
		fastcgi_param SERVER_PORT $envoryx_port;
		fastcgi_read_timeout 3600;
	}

	location ~ /\.(?!well-known) {
		deny all;
	}
}
